# The 3x3 block under the left hand, read the way a numpad is laid out:
#
#   W E R        7 8 9
#   S D F   =    4 5 6
#   Z X C        1 2 3
#
# The compositor bindings and the bar's workspace numbering are both derived
# from this list, so the count cannot drift between the two.
[
  "Z"
  "X"
  "C"
  "S"
  "D"
  "F"
  "W"
  "E"
  "R"
]
