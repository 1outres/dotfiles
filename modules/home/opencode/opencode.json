{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "instructions": ["AGENTS.md"],
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "sudo *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "format*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["nix", "shell", "nixpkgs#nodejs_24", "-c", "npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "playwright": {
      "type": "local",
      "command": ["nix", "shell", "nixpkgs#nodejs_24", "-c", "npx", "-y", "@playwright/mcp@latest", "--browser", "chrome", "--executable-path", "/home/loutres/.local/bin/chrome-wayland"],
      "environment": {
        "PLAYWRIGHT_MCP_HEADLESS": "false",
        "WAYLAND_DISPLAY": "wayland-0",
        "XDG_RUNTIME_DIR": "/run/user/1000"
      }
    },
    "brave-search": {
      "type": "local",
      "command": ["nix", "shell", "nixpkgs#nodejs_24", "-c", "npx", "-y", "@brave/brave-search-mcp-server", "--transport", "stdio"],
      "environment": {
        "BRAVE_API_KEY": "{file:~/.secrets/brave-api-key}"
      }
    }
  }
}
